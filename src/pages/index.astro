---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

import HeaderSection1 from '../components/HeaderSection1.astro';
import HeaderSection2 from '../components/HeaderSection2.astro';
import HeaderSection3 from '../components/HeaderSection3.astro';
import HeaderSection4 from '../components/HeaderSection4.astro';
import HeaderSection5 from '../components/HeaderSection5.astro';

import FooterSection1 from '../components/FooterSection1.astro';
import FooterSection2 from '../components/FooterSection2.astro';
import FooterSection3 from '../components/FooterSection3.astro';
import FooterSection4 from '../components/FooterSection4.astro';
import FooterSection5 from '../components/FooterSection5.astro';

const pageTitle =
  'Lebah Hack - Teknologi, AI, Tools, SEO & Digital Modern';

const pageDescription =
  'Lebah Hack membahas AI, teknologi, SEO, tools digital, tutorial modern, automation, dan insight internet terbaru dengan tampilan cepat dan ringan.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
>

  <!-- ========================= -->
  <!-- HERO HEADER -->
  <!-- ========================= -->

  <section
    class="relative overflow-hidden border-b border-zinc-800 bg-black text-white"
  >
    <div
      class="absolute inset-0 opacity-20"
      style="
        background-image:
          radial-gradient(circle at top left,#facc15 0%,transparent 30%),
          radial-gradient(circle at bottom right,#eab308 0%,transparent 30%);
      "
    ></div>

    <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-10">

      <div class="max-w-3xl">

        <span
          class="mb-5 inline-flex rounded-full border border-yellow-500/40 bg-yellow-500/10 px-4 py-1 text-sm font-semibold text-yellow-400"
        >
          ⚡ Lebah Hack Digital Ecosystem
        </span>

        <h1
          class="text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl"
        >
          Bangun Website Modern,
          SEO Powerful,
          dan Sistem AI Masa Kini
        </h1>

        <p
          class="mt-6 max-w-2xl text-base leading-8 text-zinc-300 sm:text-lg"
        >
          Lebah Hack menghadirkan insight teknologi, AI tools,
          automation, SEO strategy, Astro framework,
          performa website cepat, dan eksperimen digital modern.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">

          <a
            href="/blog"
            class="rounded-xl bg-yellow-400 px-6 py-3 font-bold text-black transition hover:scale-105"
          >
            Jelajahi Artikel
          </a>

          <a
            href="/about"
            class="rounded-xl border border-zinc-700 px-6 py-3 font-semibold text-white transition hover:border-yellow-400 hover:text-yellow-400"
          >
            Tentang Lebah Hack
          </a>

        </div>

      </div>

    </div>
  </section>

  <!-- ========================= -->
  <!-- HEADER COMPONENTS -->
  <!-- ========================= -->

  <HeaderSection1 />
  <HeaderSection2 />
  <HeaderSection3 />
  <HeaderSection4 />
  <HeaderSection5 />

  <!-- ========================= -->
  <!-- MAIN CONTENT -->
  <!-- ========================= -->

  <main class="bg-zinc-950 text-white">

    <!-- FEATURE SECTION -->

    <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">

      <div class="mb-14 text-center">

        <h2 class="text-3xl font-black sm:text-4xl">
          Kenapa Memilih Lebah Hack?
        </h2>

        <p class="mx-auto mt-4 max-w-2xl text-zinc-400">
          Fokus pada performa, branding, SEO modern,
          dan teknologi masa depan dengan pengalaman ringan dan cepat.
        </p>

      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">🚀</div>
          <h3 class="mt-4 text-xl font-bold">
            Ultra Fast Website
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Dibangun menggunakan Astro untuk performa super ringan
            dan loading cepat.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">🤖</div>
          <h3 class="mt-4 text-xl font-bold">
            AI & Automation
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Eksplorasi AI tools, workflow automation,
            dan sistem digital modern.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">📈</div>
          <h3 class="mt-4 text-xl font-bold">
            SEO Strategy
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Optimasi ranking, topical authority,
            dan struktur website modern.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <div class="text-3xl">🛡️</div>
          <h3 class="mt-4 text-xl font-bold">
            Clean Architecture
          </h3>
          <p class="mt-3 text-sm leading-7 text-zinc-400">
            Struktur project lebih rapi,
            scalable, dan mudah maintenance.
          </p>
        </div>

      </div>

    </section>

    <!-- FOOTER COMPONENTS -->

    <FooterSection1 />
    <FooterSection2 />
    <FooterSection3 />
    <FooterSection4 />
    <FooterSection5 />

  </main>

</MainLayout>
