---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const { slug } = Astro.params;

// ambil semua post
const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

// kalau ada slug → mode detail
const post = slug
  ? posts.find((p) => p.slug === slug)
  : null;
---

<MainLayout title={post ? post.data.title : "Blog"}>
  
  {post ? (
    <!-- ================= DETAIL PAGE ================= -->
    <article>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>

      <details class="faq-item">
        <summary>Apakah mendukung AGC modern?</summary>
        <p>Ya, struktur mendukung AGC modern enterprise.</p>
      </details>

      <a href="/blog">← Kembali ke blog</a>
    </article>

  ) : (
    <!-- ================= LIST PAGE (/blog) ================= -->
    <section>
      <h1>Blog</h1>

      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`}>
              {post.data.title}
            </a>
            <small>{post.data.pubDate}</small>
          </li>
        ))}
      </ul>
    </section>
  )}

</MainLayout>
