---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

import HeaderSection1 from '../components/HeaderSection1.astro';
import HeaderSection2 from '../components/HeaderSection2.astro';
import HeaderSection3 from '../components/HeaderSection3.astro';
import HeaderSection4 from '../components/HeaderSection4.astro';
import HeaderSection5 from '../components/HeaderSection5.astro';

import FeaderSection1 from '../components/FeaderSection1.astro';
import FeaderSection2 from '../components/FeaderSection2.astro';
import FeaderSection3 from '../components/FeaderSection3.astro';
import FeaderSection4 from '../components/FeaderSection4.astro';
import FeaderSection5 from '../components/FeaderSection5.astro';
---

<MainLayout
  title={SITE.title}
  description={SITE.description}
  canonical={SITE.url()}
>

  <HeaderSection1 />
  <HeaderSection2 />
  <HeaderSection3 />
  <HeaderSection4 />
  <HeaderSection5 />

  <FeaderSection1 />
  <FeaderSection2 />
  <FeaderSection3 />
  <FeaderSection4 />
  <FeaderSection5 />

</MainLayout>
